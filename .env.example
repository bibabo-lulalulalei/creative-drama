# 工具凭证配置（勿提交/外传；本目录不在 git 仓内，但仍不应外传）
# 加载方式：各工具缺省读本文件（skill 根 .env），也可用 --config 指向别处，
# 或提前 source 进环境变量（环境变量优先）。

# ── 联网搜索（tools/search/web_search.py）──────────────────────────
SEARCH_ENGINE_HOST=
SEARCH_ENGINE_SUBSCRIPTION_KEY=

# ── 知脑中转生图（tools/image/zhinao_image.py）─────────────────────
# model_id / 直通字段由 tools/image/zhinao_image.json 管理。
# 参考生图强制走 /images/edits；该中转站会换上游通道，model_id 可能突然失效。
GROK_MODELS_BASE_URL=
XAI_API_KEY=

# ── MiniMax H3 视频生成（tools/video/h3.py，AutoDL ComfyUI）────────
AUTODL_API_KEY=

# ── 音色生成（tools/tts/qwen3tts_autodl.py，AutoDL SSH）───────────
AUTODL_SSH_HOST=
AUTODL_SSH_PORT=
AUTODL_SSH_USER=
AUTODL_SSH_PASSWORD=

# ── S3 上传（tools/s3/upload.py）──────────────────────────────────
# 该项也可单独放在 tools/s3/s3.env（见 s3.env.example）。
OSS_ENDPOINT_URL=
OSS_BUCKET_NAME=
OSS_ACCESS_KEY_ID=
OSS_SECRET_KEY_SECRET=
OSS_ANTI_THEFT_CHAIN=
