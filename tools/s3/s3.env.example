# S3 上传配置。复制本文件为同目录 s3.env 并填入真实值（s3.env 不要提交/外传）。
# 也可直接在系统环境变量中设置（环境变量优先）。
OSS_ENDPOINT_URL=https://s3.example.com
OSS_BUCKET_NAME=your-bucket
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_SECRET_KEY_SECRET=your-secret-access-key
# CDN/防盗链域名，上传后返回的访问链接前缀（不要以 / 结尾）
OSS_ANTI_THEFT_CHAIN=https://cdn.example.com
